{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(godfs_raft_is_leader)", "legendFormat": "leaders" }
      ],
      "title": "Raft leaders",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "max(godfs_data_under_replicated_chunks)", "legendFormat": "under-replicated" }
      ],
      "title": "Under-replicated chunks",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "targets": [
        { "expr": "max(godfs_maint_rebalance_queue_depth)", "legendFormat": "queue" }
      ],
      "title": "Rebalance queue depth",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "targets": [
        { "expr": "max(godfs_data_pending_deletes)", "legendFormat": "pending" }
      ],
      "title": "Pending deletes",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "targets": [
        { "expr": "sum(rate(godfs_rest_http_requests_total[5m])) by (route)", "legendFormat": "{{route}}" }
      ],
      "title": "REST requests / s",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "targets": [
        { "expr": "godfs:rest_http_request_duration_seconds:p95:all", "legendFormat": "p95 all routes" },
        { "expr": "max(godfs:grpc_server_handling_seconds:p99:max)", "legendFormat": "gRPC unary p99 max" }
      ],
      "title": "Latency (REST p95, gRPC p99 max)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "targets": [
        { "expr": "godfs:grpc_server_handling_seconds:p99", "legendFormat": "{{grpc_method}}" }
      ],
      "title": "gRPC unary p99 by method",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
